// Cloudflare Workers の設定（静的な SPA を Workers の静的アセットとして配信。Vercel から移行、2026-10-31）
// - dist/ をそのまま配る。見つからないパスは index.html に落とす（SPA）
// - public/_headers のヘッダ（CSP・キャッシュ）はそのまま効く
// - 本番ドメイン tomoshibi.gikyokutosyokan.com は routes の custom_domain で結びつける（DNS は Cloudflare が作る）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tomoshibi",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "tomoshibi.gikyokutosyokan.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
